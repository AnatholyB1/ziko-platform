{
  "buildCommand": "",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/app" }
  ],
  "crons": [
    {
      "path": "/supplements/cron/scrape",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/storage/cron/cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/coach/ai/monitor-cron",
      "schedule": "0 7 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ."
}
