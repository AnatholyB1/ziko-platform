    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@ziko/coach-sdk": "*",
    "@ziko/email": "*",
    "ai": "^6.0.116",
    "canvas": "^3.2.3",
    "expo-server-sdk": "^6.1.0",
    "hono": "^4.7.0",
    "mammoth": "^1.12.0",
    "nanoid": "^3.3.12",
    "pdfjs-dist": "^5.7.284",
    "resend": "^6.12.3",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
