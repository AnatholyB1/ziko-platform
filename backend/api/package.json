{
  "name": "@ziko/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env PORT=8080 tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env.prod dist/index.js",
    "type-check": "tsc --noEmit",
