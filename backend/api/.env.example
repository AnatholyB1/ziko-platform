SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=owner/repo
SUPABASE_SERVICE_KEY=          # Service role key — used ONLY for coach-exercises signed URL generation (GET /coach/exercises/:id/media-url)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# OpenAI Whisper transcription (Phase 01 — Retour Vocal)
OPENAI_API_KEY=sk-...
OPENAI_API_KEY=
# Application-level email verification (Resend); values live on Vercel, never committed
EMAIL_FROM=
EMAIL_VERIFY_RPC_SECRET=
RESEND_API_KEY=

# App-side email verification (Resend), see supabase/portfolio-migrations/20261107180000_ziko_email_verification.sql
EMAIL_FROM=Ziko <no-reply@mail.ziko-app.com>
EMAIL_VERIFY_RPC_SECRET=   # random 64 hex; its sha256 lives in ziko_email_verify_settings (backend_secret_sha256)
