# apps/web environment template — copy to apps/web/.env.local for dev,
# set in Vercel Project ziko-web Production + Preview scopes for deploy.
#
# Phase 23 origin: c:/ziko-web/.env (verified 2026-05-14)

# ─── Supabase (@supabase/ssr factories — client + server + middleware) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key-from-supabase-dashboard>

# ─── Supabase legacy admin (src/lib/supabase/admin.ts — GDPR delete only) ──
# SECURITY: service role key — server-only, ESLint-allowlisted to admin.ts
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard>

# ─── Upstash (rate limiting — already wired in c:/ziko-web; Phase 25 reuses) ──
UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token-from-upstash-dashboard>

# ─── Site URL (used by layout, robots.ts, sitemap.ts, locale home page) ──
NEXT_PUBLIC_SITE_URL=https://ziko-app.com

# ─── Phase 23 Pro-tier probe gate ──────────────────────────────────────
# Set to "on" ONLY in the Vercel Preview scope to enable /api/_debug/limits.
# Leave UNSET in Production scope. Phase 24 deletes the probe.
# DEBUG_LIMITS=on
