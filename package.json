{
  "name": "ziko-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "backend/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "mobile": "turbo run dev --filter=mobile",
    "backend": "turbo run dev --filter=api",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:import": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@chrisai/seed": "^0.1.3",
    "@react-email/components": "^1.0.12",
    "@supabase/supabase-js": "^2.99.2",
    "fastest-levenshtein": "1.0.16",
    "react-dom": "19.2.6",
    "sharp": "0.34.5",
    "zod": "^4.3.6"
  }
}
