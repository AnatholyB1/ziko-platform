{
  "name": "@ziko/email",
  "version": "0.1.0",
  "private": false,
  "description": "React Email templates for Ziko platform (weekly coaching digest).",
  "type": "module",
  "main": "./dist/WeeklyDigest.cjs",
  "module": "./dist/WeeklyDigest.mjs",
  "types": "./dist/WeeklyDigest.d.ts",
  "exports": {
    "./templates/WeeklyDigest": {
      "import": "./dist/WeeklyDigest.mjs",
      "require": "./dist/WeeklyDigest.cjs",
      "types": "./dist/WeeklyDigest.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
